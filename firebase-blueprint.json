{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Product catalog item in Zeemba Cosmetics store",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "brand": { "type": "string" },
        "category": { "type": "string" },
        "subcategory": { "type": "string" },
        "description": { "type": "string" },
        "shortDescription": { "type": "string" },
        "images": { "type": "array" },
        "thumbnail": { "type": "string" },
        "mrp": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "discountPercent": { "type": "number" },
        "stock": { "type": "number" },
        "sku": { "type": "string" },
        "barcode": { "type": "string" },
        "variants": { "type": "array" },
        "tags": { "type": "array" },
        "ingredients": { "type": "string" },
        "howToUse": { "type": "string" },
        "weightVolume": { "type": "string" },
        "isFeatured": { "type": "boolean" },
        "isNewArrival": { "type": "boolean" },
        "isBestSeller": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "category", "sellingPrice", "stock", "isActive"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category definition",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "displayOrder": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "slug", "isActive"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "pincode": { "type": "string" },
        "deliveryInstructions": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "orderStatus": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["customerName", "phone", "address", "city", "pincode", "items", "total", "orderStatus"]
    },
    "Wishlist": {
      "title": "Wishlist",
      "description": "Customer wishlist items",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "productIds": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "productIds"]
    },
    "Cart": {
      "title": "Cart",
      "description": "Customer cart items",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "items"]
    },
    "Offer": {
      "title": "Offer",
      "description": "Promotional offers and coupons",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "bannerUrl": { "type": "string" },
        "description": { "type": "string" },
        "discountType": { "type": "string" },
        "discountValue": { "type": "number" },
        "couponCode": { "type": "string" },
        "minOrderValue": { "type": "number" },
        "maxDiscount": { "type": "number" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "applicableCategories": { "type": "array" },
        "applicableProducts": { "type": "array" },
        "usageLimit": { "type": "number" },
        "perUserLimit": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "discountType", "discountValue", "isActive"]
    },
    "Review": {
      "title": "Review",
      "description": "Product review by verified customer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "rating": { "type": "number" },
        "title": { "type": "string" },
        "comment": { "type": "string" },
        "isVerifiedPurchase": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["productId", "customerId", "rating", "comment"]
    },
    "HomepageContent": {
      "title": "HomepageContent",
      "description": "Dynamic homepage CMS blocks and banners",
      "type": "object",
      "properties": {
        "heroTitle": { "type": "string" },
        "heroSubtitle": { "type": "string" },
        "heroCtaText": { "type": "string" },
        "heroCtaLink": { "type": "string" },
        "heroBannerUrl": { "type": "string" },
        "announcementText": { "type": "string" },
        "promoBanners": { "type": "array" },
        "featuredCategoryIds": { "type": "array" },
        "featuredProductIds": { "type": "array" },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "AnalyticsEvent": {
      "title": "AnalyticsEvent",
      "description": "Real-time client analytics events",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "eventName": { "type": "string" },
        "customerId": { "type": "string" },
        "metadata": { "type": "object" },
        "timestamp": { "type": "string" }
      },
      "required": ["eventName", "timestamp"]
    },
    "AdminActivityLog": {
      "title": "AdminActivityLog",
      "description": "Audit trail log of admin actions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "adminId": { "type": "string" },
        "adminEmail": { "type": "string" },
        "action": { "type": "string" },
        "targetType": { "type": "string" },
        "targetId": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["adminEmail", "action", "timestamp"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Global store configuration and contact details",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "supportEmail": { "type": "string" },
        "supportPhone": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "freeDeliveryThreshold": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "currency": { "type": "string" },
        "instagramUrl": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "RBAC user permission role record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "name": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered customer profile",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "addresses": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "email"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Cosmetic products catalog"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Product categories"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders"
    },
    "/wishlists/{userId}": {
      "schema": { "$ref": "#/entities/Wishlist" },
      "description": "Customer wishlist"
    },
    "/carts/{userId}": {
      "schema": { "$ref": "#/entities/Cart" },
      "description": "Customer persistent cart"
    },
    "/offers/{offerId}": {
      "schema": { "$ref": "#/entities/Offer" },
      "description": "Promotional offers and discounts"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Customer product reviews"
    },
    "/homepage/{docId}": {
      "schema": { "$ref": "#/entities/HomepageContent" },
      "description": "Homepage CMS blocks"
    },
    "/analyticsEvents/{eventId}": {
      "schema": { "$ref": "#/entities/AnalyticsEvent" },
      "description": "Client analytics events"
    },
    "/adminActivityLogs/{logId}": {
      "schema": { "$ref": "#/entities/AdminActivityLog" },
      "description": "Audit logs for admin actions"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/StoreSettings" },
      "description": "Store configuration"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Admin RBAC permissions"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Customer account details"
    }
  }
}
